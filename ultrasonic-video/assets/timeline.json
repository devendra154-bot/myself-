{
"fps": 30,
"duration": 60,
"pingPeriod": 1.6,
"engine": "kokoro",
"scenes": [
{
"id": 1,
"title": "Introduction",
"start": 0.0,
"end": 9.448,
"lines": [
{
"start": 0.764,
"dur": 2.037,
"text": "Hi friends! I'm the Ultrasonic Sensor."
},
{
"start": 3.287,
"dur": 1.822,
"text": "Call me H C S R zero four."
},
{
"start": 5.596,
"dur": 3.157,
"text": "These look like eyes, but one is my mouth, and one is my ear!"
}
]
},
{
"id": 2,
"title": "How I Work",
"start": 9.448,
"end": 19.917,
"lines": [
{
"start": 10.212,
"dur": 1.896,
"text": "I send out sound too high for you to hear."
},
{
"start": 12.594,
"dur": 2.469,
"text": "It hits an object and bounces back as an echo."
},
{
"start": 15.55,
"dur": 1.795,
"text": "I time the echo to find the distance."
},
{
"start": 17.831,
"dur": 1.391,
"text": "Bats do the very same thing!"
}
]
},
{
"id": 3,
"title": "The Formula",
"start": 19.917,
"end": 27.996,
"lines": [
{
"start": 20.681,
"dur": 3.463,
"text": "Distance equals speed of sound, times time, divided by two."
},
{
"start": 24.63,
"dur": 2.671,
"text": "Divided by two, because the sound goes there and back!"
}
]
},
{
"id": 4,
"title": "My Specs",
"start": 27.996,
"end": 38.947,
"lines": [
{
"start": 28.76,
"dur": 2.329,
"text": "I measure from two centimetres to four metres."
},
{
"start": 31.575,
"dur": 1.37,
"text": "I run on just five volts."
},
{
"start": 33.431,
"dur": 4.82,
"text": "My pins are V C C, Trig, Echo and Ground. Arduino is my best friend!"
}
]
},
{
"id": 5,
"title": "Where I Work",
"start": 38.947,
"end": 50.112,
"lines": [
{
"start": 39.711,
"dur": 1.468,
"text": "I help cars park safely."
},
{
"start": 41.665,
"dur": 1.543,
"text": "I guide robots around walls."
},
{
"start": 43.694,
"dur": 1.245,
"text": "I check water in tanks."
},
{
"start": 45.425,
"dur": 1.995,
"text": "I warn blind people about obstacles."
},
{
"start": 47.907,
"dur": 1.51,
"text": "And I open smart dustbins!"
}
]
},
{
"id": 6,
"title": "Finale",
"start": 50.112,
"end": 60,
"lines": [
{
"start": 50.876,
"dur": 1.583,
"text": "I'm small, but my job is big!"
},
{
"start": 52.944,
"dur": 1.876,
"text": "Use me in your next science project!"
},
{
"start": 55.307,
"dur": 3.198,
"text": "Ultrasonic Sensor. The smart friend that measures distance!"
}
]
}
],
