# ---- Server ----
PORT=3000
# Public HTTPS address of this server (Render/Railway/your domain). No trailing slash.
PUBLIC_URL=https://your-app.onrender.com
# Long random strings. ADMIN_TOKEN signs you in to /dashboard.
ADMIN_TOKEN=change-me-to-a-long-random-string
INBOUND_SECRET=another-long-random-string
DATA_FILE=./data/db.json
TIMEZONE=Asia/Kolkata
# Legal calling window in India (TRAI): 09:00-21:00
CALL_WINDOW_START=09:00
CALL_WINDOW_END=21:00

# ---- Phone provider: twilio or plivo ----
TELEPHONY_PROVIDER=plivo
# Your business number in E.164 (bought from the provider, DLT registered)
CALLER_ID=+918000000000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# ---- Claude (conversation brain) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = fastest replies on calls; medium/high = more careful, slower
CLAUDE_EFFORT=low
# set to "fast" for faster replies at 2x price
CLAUDE_SPEED=

# ---- ElevenLabs (voice + speech recognition) ----
ELEVENLABS_API_KEY=
# Default voice id (pick one at elevenlabs.io > Voices; Indian voices recommended)
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 = lowest latency. Use eleven_v3 for Telugu/Kannada/Malayalam/Marathi if flash sounds wrong.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# ---- Optional ----
# Send WhatsApp messages mid-call (Meta WhatsApp Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Every finished call is POSTed here as JSON (Pabbly, Zapier, Google Apps Script, your CRM)
OUTCOME_WEBHOOK_URL=
