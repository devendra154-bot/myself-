# ---- Server ----
PORT=3000
# Public HTTPS address of this server (Render/Railway/your domain). No trailing slash.
PUBLIC_URL=https://your-app.onrender.com
# Long random strings. ADMIN_TOKEN signs you in to /dashboard.
ADMIN_TOKEN=change-me-to-a-long-random-string
INBOUND_SECRET=another-long-random-string
DATA_FILE=./data/db.json
TIMEZONE=Asia/Kolkata
# Legal calling window in India (TRAI): 09:00-21:00
CALL_WINDOW_START=09:00
CALL_WINDOW_END=21:00

# ---- Phone provider: twilio or plivo ----
TELEPHONY_PROVIDER=plivo
# Your business number in E.164 (bought from the provider, DLT registered)
CALLER_ID=+918000000000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# ---- Claude (conversation brain) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = fastest replies on calls; medium/high = more careful, slower
CLAUDE_EFFORT=low
# set to "fast" for faster replies at 2x price
CLAUDE_SPEED=

# ---- Voice provider: elevenlabs or sarvam ----
# Hears the caller (speech-to-text) and speaks the AI's replies (text-to-speech).
VOICE_PROVIDER=elevenlabs

# ---- Sarvam AI (Indian languages; used when VOICE_PROVIDER=sarvam) ----
# API key from the Sarvam dashboard (dashboard.sarvam.ai)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
# codemix = English words stay in English letters (good for Hinglish / Tenglish). transcribe = native script only.
SARVAM_STT_MODE=codemix
# bulbul:v3 = 37 voices, all 11 languages. bulbul:v4-flash = 200+ persona voices like simran_en_customer.
SARVAM_TTS_MODEL=bulbul:v3
# Default voice. bulbul:v3 voices include shubh, priya, ritu, neha, kavya, simran, rahul, rohan, amit, kavitha...
SARVAM_SPEAKER=shubh
# Speaking speed, 0.5 to 2.0
SARVAM_PACE=1.0

# ---- ElevenLabs (voice + speech recognition) ----
ELEVENLABS_API_KEY=
# Default voice id (pick one at elevenlabs.io > Voices; Indian voices recommended)
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 = lowest latency. Use eleven_v3 for Telugu/Kannada/Malayalam/Marathi if flash sounds wrong.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# ---- WhatsApp bot (Meta WhatsApp Cloud API) ----
# Also used to send WhatsApp messages mid-call.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Make up any long random text, and type the same value in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Meta app > App settings > Basic > App secret
WHATSAPP_APP_SECRET=
# on = AI replies automatically; off = only forwards messages to you
WHATSAPP_BOT=on
WHATSAPP_MODEL=claude-sonnet-5-5
# Your personal WhatsApp number(s) for alerts and #commands. NOT the bot's number. Comma separated.
ESCALATION_WHATSAPP=
# Optional approved template (one {{1}} variable) used when you haven't messaged the bot in 24 hours
WHATSAPP_ESCALATION_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Alerts by email too (resend.com API key). Leave empty to skip email.
RESEND_API_KEY=
ESCALATION_EMAIL=
EMAIL_FROM=DevInventor Bot <onboarding@resend.dev>
# Name the bot uses for you, e.g. "Devendra" (default: the DevInventor team)
BOT_OWNER_NAME=

# ---- Optional ----
# Every finished call is POSTed here as JSON (Pabbly, Zapier, Google Apps Script, your CRM)
OUTCOME_WEBHOOK_URL=

# ---- Pricing plans (what you charge per connected minute, excl. GST) ----
PRICE_BASIC=4.5
PRICE_STANDARD=6
PRICE_PREMIUM=8
CLAUDE_MODEL_BASIC=claude-haiku-5-5
CLAUDE_MODEL_STANDARD=claude-sonnet-5-5
# Premium uses CLAUDE_MODEL above (claude-opus-5-5)

# ---- Your costs (for the margin estimate on the dashboard) ----
# Defaults are rough estimates. Replace them with the rates on your invoices.
USD_INR=88
COST_PHONE_PER_MIN_INR=0.6
COST_TTS_USD_PER_1K_CHARS=0.05
COST_STT_USD_PER_HOUR=0.4
